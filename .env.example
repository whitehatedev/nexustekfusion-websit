# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional - connects server persistence directly to Supabase Postgres/PostgREST)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Session Signing Secret (auto-generated fallback if omitted in local dev)
SESSION_SECRET=""

# Razorpay Backend Credentials (also editable securely in Super Admin > Payment Settings)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Outbound Email Delivery (Optional - configure Resend or HTTP webhook; falls back to audit log when blank)
RESEND_API_KEY=""
EMAIL_WEBHOOK_URL=""
EMAIL_FROM="NexusTekFusion <info@nexustekfusion.in>"

# Outbound Mobile SMS OTP Provider (Optional - configure Twilio or MSG91; returns dev OTP preview if blank)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# Optional 3D Slicing & CAD Conversion Executables (PrusaSlicer/CuraEngine & OpenCascade/FreeCAD STEP converter)
SLICER_BIN_PATH=""
CAD_CONVERTER_CMD=""
